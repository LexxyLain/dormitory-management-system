# Database Configuration (Optional - for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/dorm_management
# DATABASE_SECRET=your_database_secret_key

# Authentication (Optional - for production)
# AUTH_SECRET=your_very_secure_random_string_min_32_chars

# Email Service (Optional - for notifications)
# RESEND_API_KEY=your_resend_api_key
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Payment Processing (Optional - for billing integration)
# STRIPE_SECRET_KEY=sk_test_your_stripe_key
# STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Third-party Services (Optional)
# CLOUDINARY_API_KEY=your_cloudinary_key
# CLOUDINARY_API_SECRET=your_cloudinary_secret
# CLOUDINARY_CLOUD_NAME=your_cloud_name

# Feature Flags (Optional)
# NEXT_PUBLIC_FEATURE_ANALYTICS=true
# NEXT_PUBLIC_FEATURE_PAYMENTS=false

# Notes:
# - This file is for reference only
# - Copy it to .env.local for local development
# - Never commit actual secrets - add them to Vercel dashboard instead
# - NEXT_PUBLIC_* variables are exposed to the browser (use for non-sensitive config only)
# - Other variables are kept server-side (secure)
